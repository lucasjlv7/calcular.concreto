<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dosagem ABCP - UFRN</title>

<style>

:root{
    --primary:#003da5;
    --primary2:#2563eb;
    --bg1:#0b1220;
    --bg2:#0f1b33;
    --card:rgba(255,255,255,0.08);
    --stroke:rgba(255,255,255,0.12);
    --text:#e5e7eb;
    --muted:#94a3b8;
}

body{
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
    margin:0;
    padding:18px;
    color:var(--text);
    max-width:760px;
    margin:auto;
    background: radial-gradient(circle at top, #14213d, #050914 70%);
    min-height:100vh;
}

.tela{ display:none; animation:fade .4s ease; }
.ativa{ display:block; }

@keyframes fade{
    from{opacity:0; transform:translateY(10px)}
    to{opacity:1; transform:translateY(0)}
}

.topo{
    display:flex;
    align-items:center;
    gap:14px;
    margin:10px 0 22px;
}

.logo{
    width:64px;
    height:64px;
    border-radius:20px;
    background:linear-gradient(135deg,var(--primary),var(--primary2));
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:28px;
    box-shadow:0 15px 40px rgba(0,0,0,0.5);
}

h1{ margin:0; font-size:26px; }

p{ margin:3px 0 0; color:var(--muted); font-size:14px; }

.card{
    background:var(--card);
    border:1px solid var(--stroke);
    border-radius:22px;
    padding:18px;
    margin-bottom:16px;
    backdrop-filter: blur(14px);
    box-shadow:0 20px 50px rgba(0,0,0,0.35);
}

h2{
    font-size:12px;
    letter-spacing:1px;
    color:#93c5fd;
    text-transform:uppercase;
    margin-top:0;
    border-bottom:1px solid rgba(147,197,253,0.2);
    padding-bottom:6px;
}

.grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

label{
    display:block;
    font-size:11px;
    font-weight:600;
    color:var(--muted);
    margin-top:8px;
}

input,select{
    width:100%;
    padding:14px;
    border-radius:14px;
    border:1px solid rgba(255,255,255,0.12);
    background:rgba(255,255,255,0.06);
    color:white;
    font-size:15px;
    outline:none;
    transition:.2s;
}

input:focus,select:focus{
    border-color:#60a5fa;
    box-shadow:0 0 0 3px rgba(96,165,250,0.2);
}

button{
    width:100%;
    border:none;
    border-radius:18px;
    padding:16px;
    background:linear-gradient(135deg,var(--primary),var(--primary2));
    color:white;
    font-size:16px;
    font-weight:700;
    cursor:pointer;
    margin-top:10px;
    transition:.2s;
}

button:hover{
    transform:translateY(-2px);
    box-shadow:0 15px 30px rgba(37,99,235,0.35);
}

button:active{ transform:scale(0.98); }

.menuBtn{
    display:block;
    margin:10px 0;
}

.res{
    display:none;
}

.line{
    display:flex;
    justify-content:space-between;
    padding:10px 0;
    border-bottom:1px solid rgba(255,255,255,0.08);
    font-size:14px;
}

.destaque{
    background:rgba(255,255,255,0.08);
    border-radius:14px;
    padding:10px 12px;
    margin:8px 0;
    font-weight:700;
    border:1px solid rgba(96,165,250,0.2);
}

b{ color:#60a5fa; }

.menuCard{
    display:flex;
    flex-direction:column;
    gap:12px;
}

.menuBtn{
    padding:16px;
    border-radius:16px;
    background:rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.12);
    color:white;
    font-size:15px;
    font-weight:600;
    cursor:pointer;
    transition:.2s;
}

.menuBtn:hover{
    background:rgba(255,255,255,0.12);
    transform:translateY(-2px);
}

@media(max-width:600px){
    .grid{ grid-template-columns:1fr; }
}

</style>
</head>

<body>

<!-- MENU -->
<div id="menu" class="tela ativa">

<div class="topo">
<div class="logo">🧱</div>
<div>
<h1>Dosagem ABCP</h1>
<p>Sistema profissional de cálculo</p>
</div>
</div>

<div class="card menuCard">
<h2>MENU PRINCIPAL</h2>

<button class="menuBtn" onclick="ir('calc')">🧮 Iniciar Cálculo</button>
<button class="menuBtn" onclick="ir('info')">ℹ️ Informações Técnicas</button>
<button class="menuBtn" onclick="ir('sobre')">📘 Sobre o Método ABCP</button>
</div>

</div>

<!-- CALCULO (INTACTO) -->
<div id="calc" class="tela">

<div class="card">
<h2>1. Critérios e Durabilidade</h2>

<div class="grid">
<div>
<label>Fck (MPa)</label>
<input type="number" id="fck">
</div>
<div>
<label>Controle (Sd)</label>
<select id="sd">
<option value="" selected disabled hidden></option>
<option value="4">Tipo A - 4,0</option>
<option value="5.5">Tipo B - 5,5</option>
<option value="7">Tipo C - 7,0</option>
</select>
</div>
<div>
<label>Classe do Cimento</label>
<select id="classe">
<option value="" selected disabled hidden></option>
<option value="25">25 MPa</option>
<option value="32">32 MPa</option>
<option value="40">40 MPa</option>
</select>
</div>
<div>
<label>Slump Y (mm)</label>
<input type="number" id="y">
</div>
<div>
<label>Dmax (mm)</label>
<select id="dmax">
<option value="" selected disabled hidden></option>
<option value="9.5">9,5</option>
<option value="19">19</option>
<option value="25">25</option>
<option value="38">38</option>
</select>
</div>
</div>
</div>

<div class="card">
<h2>2. Laboratório</h2>
<div class="grid">
<div><label>gc</label><input id="gc"></div>
<div><label>dc</label><input id="dc"></div>
<div><label>g1</label><input id="g1"></div>
<div><label>d1</label><input id="d1"></div>
<div><label>g2</label><input id="g2"></div>
<div><label>d2</label><input id="d2"></div>
<div><label>g concreto</label><input id="gconcreto"></div>
</div>
</div>

<div class="card">
<h2>3. Parâmetros</h2>
<div class="grid">
<div><label>as (%)</label><input id="as"></div>
<div><label>am (%)</label><input id="am"></div>
<div><label>ar (%)</label><input id="ar"></div>
<div><label>h (%)</label><input id="h"></div>
</div>

<label>Peça / Exposição</label>
<div class="grid">
<select id="peca">
<option value="" selected disabled hidden></option>
<option value="delgada">Peça Delgada</option>
<option value="comum">Peça Comum</option>
</select>
<select id="exp">
<option value="" selected disabled hidden></option>
<option value="comum">Ambiente Comum</option>
<option value="agressivo">Ambiente Agressivo</option>
</select>
</div>
</div>

<button onclick="calcular()">CALCULAR DOSAGEM</button>

<div id="resultado" class="card res">
<h2>RESULTADOS</h2>
<div class="line"><span>fc28:</span><b id="r_fc28"></b></div>
<div class="line"><span>a/c:</span><b id="r_x"></b></div>
<div class="line"><span>Água:</span><b id="r_a"></b></div>
<div class="line"><span>Cimento:</span><b id="r_c"></b></div>
<div class="line"><span>M:</span><b id="r_M"></b></div>
</div>

<button onclick="ir('menu')">← Voltar</button>

</div>

<!-- INFO -->
<div id="info" class="tela">
<div class="card">
<h2>Informações Técnicas</h2>
<p>Sistema baseado no método ABCP para dosagem racional de concreto. Aplicado em engenharia civil para controle de resistência e consumo de materiais.</p>
<button onclick="ir('menu')">← Voltar</button>
</div>
</div>

<!-- SOBRE -->
<div id="sobre" class="tela">
<div class="card">
<h2>Método ABCP</h2>
<p>Metodologia amplamente utilizada no Brasil para dosagem de concreto com base na relação água/cimento e resistência característica.</p>
<button onclick="ir('menu')">← Voltar</button>
</div>
</div>

<script>

function ir(tela){
    document.querySelectorAll('.tela').forEach(t => t.classList.remove('ativa'));
    document.getElementById(tela).classList.add('ativa');
}

function arred2(v){
    return Math.round((v + Number.EPSILON) * 100) / 100;
}

function calcular(){

    const fck = parseFloat(document.getElementById('fck').value) || 0;
    const sd = parseFloat(document.getElementById('sd').value) || 0;
    const classe = parseInt(document.getElementById('classe').value) || 0;
    const y = parseFloat(document.getElementById('y').value) || 0;
    const dmax = parseFloat(document.getElementById('dmax').value) || 0;

    const gc = parseFloat(document.getElementById('gc').value) || 0;
    const dc = parseFloat(document.getElementById('dc').value) || 0;
    const g1 = parseFloat(document.getElementById('g1').value) || 0;
    const d1 = parseFloat(document.getElementById('d1').value) || 0;
    const g2 = parseFloat(document.getElementById('g2').value) || 0;
    const d2 = parseFloat(document.getElementById('d2').value) || 0;
    const gconcreto = parseFloat(document.getElementById('gconcreto').value) || 0;

    const fc28 = arred2(fck + (1.65 * sd));
    const agua = 0;

    const x = 0;
    const c = 0;

    document.getElementById('resultado').style.display='block';

    document.getElementById('r_fc28').innerText = fc28;
    document.getElementById('r_x').innerText = x;
    document.getElementById('r_a').innerText = agua;
    document.getElementById('r_c').innerText = c;
    document.getElementById('r_M').innerText = 100;
}

</script>

</body>
</html>
